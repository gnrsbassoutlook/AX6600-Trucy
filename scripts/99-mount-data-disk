#!/bin/sh
# ============================================================
#  /etc/hotplug.d/block/99-mount-data-disk
#
#  作用: 4T 数据盘「热插拔自动挂载」。
#        block 子系统在块设备出现/消失时会遍历本目录里的脚本，
#        并导出 ACTION / DEVNAME / DEVICE 等变量。
#        开机时系统也会对已存在的块设备触发一次 add —— 所以
#        本文件同时覆盖「开机」和「中途重新插上」两种情况。
#
#  卸载不在这里做：拔线/断电前请手动跑 umount-data-disk.sh，
#  让 ntfs3 刷干净缓存（否则会被写脏标记）。
# ============================================================

[ "$ACTION" = "add" ] || exit 0

# 变量名在各版本间不完全一致，一起拼起来匹配，省得漏
case "${DEVNAME}${DEVICE}${MNT}" in
	*sda2*)
		[ -x /root/mount-data-disk.sh ] && /root/mount-data-disk.sh -q
		;;
esac

exit 0
